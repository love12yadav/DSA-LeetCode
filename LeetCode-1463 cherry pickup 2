LeetCode-1463. Cherry Pickup II
class Solution {
    public int cherryPickup(int[][] grid) {
        int n = grid.length;
        int m = grid[0].length;
        Integer[][][] dp = new Integer[n][n][m+1];
        return Math.max(0,f(grid,dp,0,0,m-1));
    }
    public int f(int[][] grid,Integer[][][] dp,int r1,int c1,int c2){
        int n =grid.length;
        int m = grid[0].length;
        if (c1 <0 || c2 <0 || c1 >= m  || c2>=m )
            return 0;
        if(r1==n) return 0;
        if(dp[r1][c1][c2]!=null) return  dp[r1][c1][c2];
        int cherry= 0;
        if( c1==c2){
            cherry = grid[r1][c1]; 
        }else{
            cherry = grid[r1][c1] + grid[r1][c2];
        }

        int max =0;
        for(int i=c1-1;i<=c1+1;i++){
            for(int j=c2-1;j<=c2+1;j++){
                if(i<j){
                    max = Math.max(max,f(grid,dp,r1+1,i,j));
                }
            }
        }
        cherry+=max;
        return dp[r1][c1][c2] = cherry;
    }
}
