LeetCode-741. Cherry Pickup
class Solution {
    
    public int cherryPickup(int[][] grid) {
        int n = grid.length;
        Integer[][][] dp = new Integer[n][n][n];
        return Math.max(0,f(grid,dp,0,0,0));

    }    
    public int f(int[][] grid,Integer[][][] dp,int r1,int c1,int c2){
        int n =grid.length;
        int r2 = r1+c1-c2;
        if (r1 >= n || r2 >= n || c1 >= n || c2 >= n || grid[r1][c1] == -1 || grid[r2][c2] == -1)
            return Integer.MIN_VALUE;

        if(dp[r1][c1][c2]!=null) return  dp[r1][c1][c2];

        if (r1 == n - 1 && c1 == n - 1) return grid[r1][c1];
        int cherry=0;
        if(r1==r2 && c1==c2){
            cherry = grid[r1][c1]; 
        }else{
            cherry = grid[r1][c1] + grid[r2][c2];
        }
        int maxcherry = Math.max(f(grid,dp,r1+1,c1,c2),f(grid,dp,r1,c1+1,c2));
        maxcherry  = Math.max(maxcherry,f(grid,dp,r1,c1+1,c2+1));
        maxcherry = Math.max(f(grid,dp,r1+1,c1,c2+1),maxcherry);
        if(maxcherry == Integer.MIN_VALUE){
            dp[r1][c1][c2] =Integer.MIN_VALUE;
        }else{
            dp[r1][c1][c2] = maxcherry+cherry;
        }
        return dp[r1][c1][c2];
        
    }
}
